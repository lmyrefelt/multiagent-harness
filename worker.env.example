# Copy to .pi/worker.env (gitignored) and set these for THIS machine.
# launch-worker.sh sources it, so you don't export them every shell.

# The local model to drive the worker — use an id from:
#   curl -s "$LOCAL_LLM_BASE_URL/models" | jq -r '.data[].id'
WORKER_MODEL=local/qwen3-coder-30b-6bit

# Where oMLX serves on this machine (note the port):
LOCAL_LLM_BASE_URL=http://host.docker.internal:8001/v1

# Usually leave these at their defaults:
# IMAGE=pi-contracts:latest
# EXTENSION=/opt/contracts/extensions/contract-guard.ts
# REPO=/absolute/path/to/this/repo      # default: the git top-level of the checkout
