# Keep the build context small and free of research artifacts.
#
# The image needs exactly:
#     models.json, settings.defaults.json          (context root)
#     prototype/{contracts,extensions,compile.mjs,verify-guards.mjs,
#                image-setup.mjs,run-probes.mjs,probe-local-models.mjs}
#
# Everything else is a result, not an input.

# Probe transcripts and scorecards: large, and they are results.
prototype/evidence/

# The research sandbox, including a nested .git — never belongs in an image.
prototype/sandbox/

# Compiled output is regenerated by the build-time gate. Shipping it would let
# a stale generated/AGENTS.md pass the gate without recompiling.
prototype/generated/

# The hand-written comparison arm: a baseline, not an input to the image.
prototype/handwritten/
prototype/FINDINGS.md

# VCS and editor noise
.git
.gitignore
.DS_Store
**/.DS_Store

# Markdown at the context root only (RUNBOOK.md, and friends).
# `**/*.md` would also swallow prototype/contracts/*.yaml's neighbours, so this
# is deliberately shallow.
*.md
